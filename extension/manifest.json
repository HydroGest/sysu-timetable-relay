{
  "manifest_version": 3,
  "name": "SYSU 课表 Cookie 同步",
  "version": "1.0.0",
  "description": "自动把中山大学教务系统登录态同步到本机课表中继服务",
  "permissions": ["cookies", "tabs", "alarms"],
  "host_permissions": [
    "https://jwxt.sysu.edu.cn/*",
    "https://cas.sysu.edu.cn/*",
    "http://127.0.0.1:8123/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "SYSU 课表 Cookie 同步"
  }
}
